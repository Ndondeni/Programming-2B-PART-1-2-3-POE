@model List<Marathon.mvc.Models.dto.EnrolmentDto>
@{
    ViewData["Title"] = "Enrolments";
}
<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="events-page">
    <div class="page-heading">
        <div>
            <h2>My Enrolments</h2>
            <p>Your registrations and payment status.</p>
        </div>
    </div>

    <div class="event-section">
        <div class="section-heading">
            <h4>Registrations</h4>
            <span class="count-badge">@Model.Count</span>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <h5>No enrolments found</h5>
                <p>You have not registered for any events yet.</p>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="event-table">
                    <thead>
                        <tr>
                            <th>Event ID</th>
                            <th>Category ID</th>
                            <th>Enrolled</th>
                            <th>Status</th>
                            <th>Payment</th>
                            <th>Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="event-name">@item.EventId</td>
                                <td>@item.CategoryId</td>
                                <td>@item.enrolment_date.ToString("dd MMM yyyy")</td>
                                <td>@item.enrolment_status</td>
                                <td>@item.payment_status</td>
                                <td>R @item.amount_paid.ToString("0.00")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
