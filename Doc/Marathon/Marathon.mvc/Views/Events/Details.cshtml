@model Marathon.mvc.Models.dto.EventDto
@{
    ViewData["Title"] = Model.EventName;
}
<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="events-page">
    <div class="page-heading">
        <div>
            <h2>@Model.EventName</h2>
            <p>Event overview and details.</p>
        </div>
        <a class="btn btn-primary" asp-action="Index">Back to Events</a>
    </div>

    <div class="event-section">
        <div class="section-heading">
            <h4>Event Details</h4>
        </div>

        <div class="table-wrap">
            <table class="event-table">
                <tbody>
                    <tr><th style="width:220px;">Name</th><td>@Model.EventName</td></tr>
                    <tr><th>Type</th><td>@Model.EventType</td></tr>
                    <tr><th>Location</th><td>@Model.Location</td></tr>
                    <tr><th>Venue</th><td>@Model.Venue</td></tr>
                    <tr><th>Date</th><td>@Model.EventDate.ToString("dd MMM yyyy")</td></tr>
                    <tr><th>Distance</th><td>@Model.DistanceKm km</td></tr>
                    <tr><th>Fee</th><td>R @Model.EventFee.ToString("0.00")</td></tr>
                    <tr><th>Status</th><td>@Model.EventStatus</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>