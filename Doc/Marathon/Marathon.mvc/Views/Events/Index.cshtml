@model List<Marathon.mvc.Models.dto.EventDto>
@{
    ViewData["Title"] = "Events";
    string StatusClass(string? status)
    {
        if (string.IsNullOrWhiteSpace(status)) return "status status-ended";
        var s = status.Trim();

        if (s.Equals("Upcoming", StringComparison.OrdinalIgnoreCase) ||
            s.Equals("Pending", StringComparison.OrdinalIgnoreCase))
            return "status status-upcoming";

        if (s.Equals("Active", StringComparison.OrdinalIgnoreCase) ||
            s.Equals("Paid", StringComparison.OrdinalIgnoreCase))
            return "status status-active";

        return "status status-ended";
    }
}
<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="events-page">
    <partial name="_Toast" />

    <div class="page-heading">
        <div>
            <h2>Events</h2>
            <p>All current marathon and event listings.</p>
        </div>
    </div>

    <div class="event-section">
        <div class="section-heading">
            <h4>All Events</h4>
            <span class="count-badge">@Model.Count</span>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <h5>No events found</h5>
                <p>No event records are available right now.</p>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="event-table">
                    <thead>
                        <tr>
                            <th>Event</th>
                            <th>Location</th>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Fee</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="event-name">@item.EventName</td>
                                <td>@item.Location</td>
                                <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                                <td>@item.EventType</td>
                                <td>R @item.EventFee.ToString("0.00")</td>
                                <td><span class="@StatusClass(item.EventStatus)">@item.EventStatus</span></td>
                                <td><a asp-action="Details" asp-route-id="@item.EventId">View</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
