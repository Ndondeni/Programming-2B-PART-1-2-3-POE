@model Marathon.mvc.Models.dto.LoginDTO

@{
    ViewData["Title"] = "Login";
}

<form asp-controller="Account" asp-action="Index" method="post" class="form">
    @Html.AntiForgeryToken()

    <p class="form-title">Sign in to your account</p>

    <!-- ADD THIS: This will show the "Invalid email or password" error if the API rejects it -->
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="form-group">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="input-container" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Password"></label>
        <input asp-for="Password" type="password" class="input-container" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Login</button>

    <p class="signup-link">
        No account?
        <a asp-controller="Account" asp-action="SignUp">Sign up</a>
    </p>
</form>