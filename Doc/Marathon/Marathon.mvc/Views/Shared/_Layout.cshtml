<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Marathon.mvc</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Marathon.mvc.styles.css" asp-append-version="true" />
</head>
<body class="app-body">

    <!-- ===== TOP NAVIGATION BAR ===== -->
    <header class="app-topbar">
        <div class="app-brand">
            <i class="bx bx-run bx-sm"></i>
            <span>Marathon.mvc</span>
        </div>

        <div class="app-search">
            <i class="fa fa-search"></i>
            <input type="text" placeholder="Search events, categories..." />
        </div>

        <div class="app-topbar-right">
            <button class="top-icon-btn" aria-label="Notifications">
                <i class="fa fa-bell-o"></i>
                <span class="top-badge">3</span>
            </button>
            <button class="top-icon-btn" aria-label="Messages">
                <i class="fa fa-envelope-o"></i>
            </button>
            <div class="top-avatar">
                <img src="https://source.unsplash.com/36x36/?human" alt="User" />
            </div>
        </div>
    </header>

    <!-- ===== LAYOUT ===== -->
    <div class="app-layout">

        <!-- Left Sidebar -->
        <aside class="app-sidebar">
            <nav class="sidebar-nav">
                <ul>
                    <li class="active">
                        <a asp-controller="Home" asp-action="Index">
                            <i class="fa fa-home"></i><span>Home</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Events" asp-action="Index">
                            <i class="fa fa-calendar"></i><span>Events</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Category" asp-action="Index">
                            <i class="fa fa-th-large"></i><span>Categories</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Result" asp-action="Index">
                            <i class="fa fa-bar-chart"></i><span>Result</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Profile" asp-action="Index">
                            <i class="fa fa-user-o"></i><span>Profile</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Login" asp-action="Index">
                            <i class="fa fa-sign-in"></i><span>Login</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </aside>

        <!-- Main Content (each page renders here) -->
        <main class="app-main">
            @RenderBody()
        </main>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>