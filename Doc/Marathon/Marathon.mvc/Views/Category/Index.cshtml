@model List<Marathon.mvc.Models.dto.CategoryDto>
@{
    ViewData["Title"] = "Categories";
}
<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="events-page">
    <div class="page-heading">
        <div>
            <h2>Categories</h2>
            <p>Race categories and participant limits.</p>
        </div>
    </div>

    <div class="event-section">
        <div class="section-heading">
            <h4>All Categories</h4>
            <span class="count-badge">@Model.Count</span>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <h5>No categories found</h5>
                <p>No categories have been returned by the API.</p>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="event-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Age Range</th>
                            <th>Gender</th>
                            <th>Max Participants</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="event-name">@item.CategoryName</td>
                                <td>@item.MinAge - @item.MaxAge</td>
                                <td>@item.GenderRestrictions</td>
                                <td>@item.MaxParticipants</td>
                                <td>@item.CreatedAt.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
