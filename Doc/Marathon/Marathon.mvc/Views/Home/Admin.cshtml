@model Marathon.mvc.Models.dto.DashboardDto
@{
    ViewData["Title"] = "Admin Dashboard";

    string StatusClass(string? status)
    {
        if (string.IsNullOrWhiteSpace(status)) return "status status-ended";
        var s = status.Trim();

        if (s.Equals("Upcoming", StringComparison.OrdinalIgnoreCase) ||
            s.Equals("Pending", StringComparison.OrdinalIgnoreCase))
            return "status status-upcoming";

        if (s.Equals("Paid", StringComparison.OrdinalIgnoreCase) ||
            s.Equals("Active", StringComparison.OrdinalIgnoreCase) ||
            s.Equals("Approved", StringComparison.OrdinalIgnoreCase))
            return "status status-active";

        return "status status-ended";
    }
}
<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="events-page">
    <div class="page-heading">
        <div>
            <h2>Admin dashboard</h2>
            <p>Operations overview across users, events, categories, payments, and results.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="add-category-btn"
                    onclick="openEventModal()">
                + New Event
            </button>

            <button type="button" class="add-category-btn" onclick="openCategoryModal()">
                + Add Category
            </button>
        </div>
       
    </div>

    <div class="event-stats">
        <div class="stat-card">
            <span>Total Users</span>
            <h3>@Model.UserCount</h3>
        </div>
        <div class="stat-card">
            <span>Total Events</span>
            <h3>@Model.EventCount</h3>
        </div>
        <div class="stat-card">
            <span>Categories</span>
            <h3>@Model.CategoryCount</h3>
        </div>
        <div class="stat-card">
            <span>Enrolments</span>
            <h3>@Model.EnrolmentCount</h3>
        </div>
        <div class="stat-card">
            <span>Results</span>
            <h3>@Model.ResultCount</h3>
        </div>
        <div class="stat-card featured">
            <span>Total Revenue</span>
            <h3>R @Model.TotalRevenue.ToString("0.00")</h3>
        </div>
    </div>

    <div class="event-section">
        <div class="section-heading">
            <h4>All Events</h4>
            <span class="count-badge">@Model.UpcomingEvents.Count</span>
        </div>

        @if (!Model.UpcomingEvents.Any())
        {
            <div class="empty-state">
                <h5>No events found</h5>
                <p>There are no marathon events available yet.</p>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="event-table">
                    <thead>
                        <tr>
                            <th>Event</th>
                            <th>Location</th>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Fee</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.UpcomingEvents)
                        {
                            <tr>
                                <td class="event-name">@item.EventName</td>
                                <td>@item.Location</td>
                                <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                                <td>@item.EventType</td>
                                <td>R @item.EventFee.ToString("0.00")</td>
                                <td><span class="@StatusClass(item.EventStatus)">@item.EventStatus</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="event-section">
        <div class="section-heading">
            <h4>Recent Enrolments</h4>
            <span class="count-badge">@Model.RecentEnrolments.Count</span>
        </div>

        @if (!Model.RecentEnrolments.Any())
        {
            <div class="empty-state">
                <h5>No enrolments</h5>
                <p>No registrations have been received yet.</p>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="event-table">
                    <thead>
                        <tr>
                            <th>Event</th>
                            <th>Status</th>
                            <th>Payment</th>
                            <th>Amount</th>
                            <th>Paid Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.RecentEnrolments)
                        {
                            var eventName = Model.UpcomingEvents.FirstOrDefault(e => e.EventId == item.EventId)?.EventName ?? "Unknown event";
                            <tr>
                                <td class="event-name">@eventName</td>
                                <td><span class="@StatusClass(item.enrolment_status)">@item.enrolment_status</span></td>
                                <td><span class="@StatusClass(item.payment_status)">@item.payment_status</span></td>
                                <td>R @item.amount_paid.ToString("0.00")</td>
                                <td>@item.paid_date.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
<div id="eventModal" class="category-modal">
    <div class="category-modal-content">

        <div class="modal-header">
            <h2>New Event</h2>
            <button type="button" class="close-btn"
                    onclick="closeEventModal()">
                &times;
            </button>
        </div>

        <form id="eventForm">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label>Event Name</label>
                <input type="text" id="EventName" required />
            </div>

            <div class="form-group">
                <label>Event Date</label>
                <input type="date" id="EventDate" required />
            </div>

            <div class="form-group">
                <label>Location</label>
                <input type="text" id="Location" required />
            </div>

            <div class="form-group">
                <label>Venue</label>
                <input type="text" id="Venue" required />
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Distance (KM)</label>
                    <input type="number" id="DistanceKm"
                           min="0.1" step="0.1" required />
                </div>

                <div class="form-group">
                    <label>Event Fee</label>
                    <input type="number" id="EventFee"
                           min="0" step="0.01" required />
                </div>
            </div>

            <div class="form-group">
                <label>Event Type</label>
                <select id="EventType" required>
                    <option value="">Select type</option>
                    <option value="Running">Running</option>
                    <option value="Walking">Walking</option>
                    <option value="Cycling">Cycling</option>
                </select>
            </div>

            <div class="form-group">
                <label>Status</label>
                <select id="Status" required>
                    <option value="Upcoming">Upcoming</option>
                    <option value="Active">Active</option>
                    <option value="Completed">Completed</option>
                </select>
            </div>

            <div id="eventMessage"></div>

            <div class="modal-actions">
                <button type="button" class="cancel-btn"
                        onclick="closeEventModal()">
                    Cancel
                </button>

                <button type="submit" class="save-btn">
                    Submit Event
                </button>
            </div>

        </form>
    </div>
</div>

<div id="eventModal" class="category-modal">
    <div class="category-modal-content">

        <div class="modal-header">
            <div>
                <h2>New Marathon Event</h2>
                <p>Enter the details for your new event.</p>
            </div>

            <button type="button" class="close-btn"
                    onclick="closeEventModal()">
                &times;
            </button>
        </div>

        <form asp-controller="Events"
              asp-action="Create"
              method="post">

           

            @Html.AntiForgeryToken()

            <div class="form-group">
                <label>Event Name</label>
                <input type="text" name="EventName"
                       placeholder="e.g. Johannesburg Marathon" required />
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Event Date</label>
                    <input type="date" name="EventDate" required />
                </div>

                <div class="form-group">
                    <label>Event Time</label>
                    <input type="datetime-local" name="Now" required />
                </div>
            </div>

            <div class="form-group">
                <label>Location</label>
                <input type="text" name="Location"
                       placeholder="Enter location" required />
            </div>

            <div class="form-group">
                <label>Venue</label>
                <input type="text" name="Venue"
                       placeholder="Enter venue" required />
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Distance (KM)</label>
                    <input type="number" name="DistanceKm"
                           step="0.1" min="0.1" required />
                </div>

                <div class="form-group">
                    <label>Event Fee (R)</label>
                    <input type="number" name="EventFee"
                           step="0.01" min="0" required />
                </div>
            </div>

            <div class="form-group">
                <label>Event Type</label>
                <select name="EventType" required>
                    <option value="">Select event type</option>
                    <option value="Running">Running</option>
                    <option value="Walking">Walking</option>
                    <option value="Cycling">Cycling</option>
                </select>
            </div>

            <div class="form-group">
                <label>Status</label>
                <select name="Status" required>
                    <option value="Upcoming">Upcoming</option>
                    <option value="Active">Active</option>
                    <option value="Completed">Completed</option>
                </select>
            </div>

            <div class="modal-actions">
                <button type="button" class="cancel-btn"
                        onclick="closeEventModal()">
                    Cancel
                </button>

                <button type="submit" class="save-btn">
                    Create Event
                </button>
            </div>
        </form>
    </div>
</div>
