@model Marathon.mvc.Models.dto.DashboardDto
@{
    ViewData["Title"] = "Admin Dashboard";

    string StatusClass(string? status)
    {
        if (string.IsNullOrWhiteSpace(status)) return "status status-ended";
        var s = status.Trim();

        if (s.Equals("Upcoming", StringComparison.OrdinalIgnoreCase) ||
            s.Equals("Pending", StringComparison.OrdinalIgnoreCase))
            return "status status-upcoming";

        if (s.Equals("Paid", StringComparison.OrdinalIgnoreCase) ||
            s.Equals("Active", StringComparison.OrdinalIgnoreCase) ||
            s.Equals("Approved", StringComparison.OrdinalIgnoreCase))
            return "status status-active";

        return "status status-ended";
    }
}
<link rel="stylesheet" href="~/css/dashboard.css" />

<div class="events-page">
    <div class="page-heading">
        <div>
            <h2>Admin dashboard</h2>
            <p>Operations overview across users, events, categories, payments, and results.</p>
        </div>
        <div>
            <a class="btn btn-primary" asp-controller="Events" asp-action="Index">New Event</a>
            <a class="btn btn-primary" asp-controller="Category" asp-action="Index" style="margin-left:10px;">New Category</a>
        </div>
    </div>

    <div class="event-stats">
        <div class="stat-card">
            <span>Total Users</span>
            <h3>@Model.UserCount</h3>
        </div>
        <div class="stat-card">
            <span>Total Events</span>
            <h3>@Model.EventCount</h3>
        </div>
        <div class="stat-card">
            <span>Categories</span>
            <h3>@Model.CategoryCount</h3>
        </div>
        <div class="stat-card">
            <span>Enrolments</span>
            <h3>@Model.EnrolmentCount</h3>
        </div>
        <div class="stat-card">
            <span>Results</span>
            <h3>@Model.ResultCount</h3>
        </div>
        <div class="stat-card featured">
            <span>Total Revenue</span>
            <h3>R @Model.TotalRevenue.ToString("0.00")</h3>
        </div>
    </div>

    <div class="event-section">
        <div class="section-heading">
            <h4>All Events</h4>
            <span class="count-badge">@Model.UpcomingEvents.Count</span>
        </div>

        @if (!Model.UpcomingEvents.Any())
        {
            <div class="empty-state">
                <h5>No events found</h5>
                <p>There are no marathon events available yet.</p>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="event-table">
                    <thead>
                        <tr>
                            <th>Event</th>
                            <th>Location</th>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Fee</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.UpcomingEvents)
                        {
                            <tr>
                                <td class="event-name">@item.EventName</td>
                                <td>@item.Location</td>
                                <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                                <td>@item.EventType</td>
                                <td>R @item.EventFee.ToString("0.00")</td>
                                <td><span class="@StatusClass(item.EventStatus)">@item.EventStatus</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="event-section">
        <div class="section-heading">
            <h4>Recent Enrolments</h4>
            <span class="count-badge">@Model.RecentEnrolments.Count</span>
        </div>

        @if (!Model.RecentEnrolments.Any())
        {
            <div class="empty-state">
                <h5>No enrolments</h5>
                <p>No registrations have been received yet.</p>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="event-table">
                    <thead>
                        <tr>
                            <th>Event</th>
                            <th>Status</th>
                            <th>Payment</th>
                            <th>Amount</th>
                            <th>Paid Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.RecentEnrolments)
                        {
                            var eventName = Model.UpcomingEvents.FirstOrDefault(e => e.EventId == item.EventId)?.EventName ?? "Unknown event";
                            <tr>
                                <td class="event-name">@eventName</td>
                                <td><span class="@StatusClass(item.enrolment_status)">@item.enrolment_status</span></td>
                                <td><span class="@StatusClass(item.payment_status)">@item.payment_status</span></td>
                                <td>R @item.amount_paid.ToString("0.00")</td>
                                <td>@item.paid_date.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
