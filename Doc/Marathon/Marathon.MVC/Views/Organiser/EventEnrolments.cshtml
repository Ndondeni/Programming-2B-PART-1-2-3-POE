@model List<EnrolmentViewModel>
@{ ViewData["Title"] = "Event Enrolments"; var eventId = (int)ViewBag.EventId; }
<h2>Event Enrolments</h2>
<a asp-action="Dashboard" class="btn btn-outline-secondary mb-3">← Back</a>
<a asp-action="EventResults" asp-route-eventId="@eventId" class="btn btn-outline-success mb-3">Results</a>
<table class="table table-striped">
    <thead><tr><th>Participant</th><th>Category</th><th>Date</th><th>Status</th><th></th></tr></thead>
    <tbody>
    @foreach (var e in Model)
    {
        <tr>
            <td>@e.ParticipantName</td>
            <td>@e.CategoryName</td>
            <td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td>
            <td><span class="badge @(e.Status == "Confirmed" ? "badge-confirmed" : "badge-pending")">@e.Status</span></td>
            <td>
                @if (e.Status == "Pending")
                {
                    <form asp-action="ConfirmEnrolment" method="post" class="d-inline">
                        <input type="hidden" name="enrolmentId" value="@e.Id" />
                        <input type="hidden" name="eventId" value="@eventId" />
                        <button type="submit" class="btn btn-sm btn-success">Confirm</button>
                    </form>
                }
            </td>
        </tr>
    }
    @if (!Model.Any()) { <tr><td colspan="5" class="text-center text-muted">No enrolments yet.</td></tr> }
    </tbody>
</table>
