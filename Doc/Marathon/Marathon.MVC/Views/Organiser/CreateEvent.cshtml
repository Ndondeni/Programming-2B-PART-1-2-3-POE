@model CreateEventViewModel
@{ ViewData["Title"] = "Create Event"; }
<h2>Create Event</h2>
<form asp-action="CreateEvent" method="post" enctype="multipart/form-data" class="card p-4 shadow-sm">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label class="form-label">Title</label>
        <input asp-for="Title" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea asp-for="Description" class="form-control" rows="3" required></textarea>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Date</label>
            <input asp-for="Date" type="date" class="form-control" required />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Location</label>
            <input asp-for="Location" class="form-control" required />
        </div>
    </div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label class="form-label">Distance (km)</label>
            <input asp-for="Distance" type="number" step="0.1" class="form-control" required />
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label">Type</label>
            <select asp-for="EventType" class="form-select">
                <option value="Run">Run</option>
                <option value="Walk">Walk</option>
                <option value="Cycle">Cycle</option>
            </select>
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label">Banner Image</label>
            <input asp-for="BannerImage" type="file" accept="image/*" class="form-control" />
        </div>
    </div>
    <div class="mb-3">
        <label class="form-label">Categories (comma separated)</label>
        <input asp-for="CategoriesCsv" class="form-control" />
        <small class="text-muted">e.g. "Under 20, Senior, 10km, 21km"</small>
    </div>
    <button type="submit" class="btn btn-primary">Create Event</button>
</form>
