@model List<EventViewModel>
@{ ViewData["Title"] = "Organiser Dashboard"; }
<h2 class="mb-4">Organiser Dashboard</h2>
<a asp-action="CreateEvent" class="btn btn-primary mb-3">+ Create New Event</a>
<table class="table table-striped">
    <thead><tr><th>Event</th><th>Date</th><th>Location</th><th>Type</th><th>Actions</th></tr></thead>
    <tbody>
    @foreach (var ev in Model)
    {
        <tr>
            <td>@ev.Title</td>
            <td>@ev.Date.ToString("dd MMM yyyy")</td>
            <td>@ev.Location</td>
            <td>@ev.EventType</td>
            <td>
                <a asp-action="EventEnrolments" asp-route-eventId="@ev.Id" class="btn btn-sm btn-outline-primary">Enrolments</a>
                <a asp-action="EventResults" asp-route-eventId="@ev.Id" class="btn btn-sm btn-outline-success">Results</a>
            </td>
        </tr>
    }
    @if (!Model.Any()) { <tr><td colspan="5" class="text-center text-muted">No events yet.</td></tr> }
    </tbody>
</table>
