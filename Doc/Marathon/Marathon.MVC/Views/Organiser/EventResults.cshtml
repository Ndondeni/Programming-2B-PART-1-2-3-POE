@model List<ResultViewModel>
@{ ViewData["Title"] = "Event Results"; var eventId = (int)ViewBag.EventId; var enrolments = ViewBag.Enrolments as List<EnrolmentViewModel> ?? new(); }
<h2>Event Results</h2>
<a asp-action="Dashboard" class="btn btn-outline-secondary mb-3">← Back</a>

<div class="row">
    <div class="col-md-6">
        <h4>Record a Result</h4>
        <form asp-action="CaptureResult" method="post" class="card p-3 mb-3">
            <input type="hidden" name="eventId" value="@eventId" />
            <div class="mb-2">
                <label class="form-label">Participant</label>
                <select name="participantId" class="form-select" required>
                    @foreach (var e in enrolments)
                    {
                        <option value="@e.ParticipantId">@e.ParticipantName (@e.CategoryName)</option>
                    }
                </select>
            </div>
            <div class="mb-2">
                <label class="form-label">Finish Time (hh:mm:ss)</label>
                <input name="finishTime" class="form-control" placeholder="01:23:45" required />
            </div>
            <div class="mb-2">
                <label class="form-label">Position</label>
                <input name="position" type="number" min="1" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-primary">Record</button>
        </form>
    </div>
    <div class="col-md-6">
        <h4>Recorded Results</h4>
        <table class="table table-striped">
            <thead><tr><th>Pos</th><th>Participant</th><th>Time</th></tr></thead>
            <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>#@r.FinishingPosition</td>
                    <td>@r.ParticipantName</td>
                    <td>@r.FinishTime.ToString(@"hh\:mm\:ss")</td>
                </tr>
            }
            @if (!Model.Any()) { <tr><td colspan="3" class="text-center text-muted">No results yet.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
