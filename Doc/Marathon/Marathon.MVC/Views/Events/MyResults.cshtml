@model List<ResultViewModel>
@{ ViewData["Title"] = "My Results"; }
<h2>My Results</h2>
<table class="table table-striped">
    <thead><tr><th>Event</th><th>Finish Time</th><th>Position</th></tr></thead>
    <tbody>
    @foreach (var r in Model)
    {
        <tr>
            <td>@r.EventTitle</td>
            <td>@r.FinishTime.ToString(@"hh\:mm\:ss")</td>
            <td><span class="badge bg-success">#@r.FinishingPosition</span></td>
        </tr>
    }
    @if (!Model.Any()) { <tr><td colspan="3" class="text-center text-muted">No results yet.</td></tr> }
    </tbody>
</table>
